# Django core — all required
SECRET_KEY=insert_secret_key
DEBUG=TRUE
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://itclub.akal.com.np

# Email — optional for local dev, required for account emails in prod.
# Use a Gmail app password, not the account password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Database — DATABASE_MODE=mysql (Docker / production) or sqlite (local).
DATABASE_MODE=mysql

# Used when DATABASE_MODE=sqlite
DATABASE_NAME=db.sqlite3

# Used when DATABASE_MODE=mysql
MYSQL_DATABASE=mydb
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=db
MYSQL_PORT=3306
